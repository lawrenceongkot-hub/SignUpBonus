# Production Application URL (used for QR code pairing links)
# Example: https://support.yourcompany.com
PUBLIC_APP_URL=https://support.example.com

# Database Connection URL (PostgreSQL for production, e.g. Neon, Supabase, AWS RDS)
DATABASE_URL="postgresql://user:password@hostname:5432/remotesupport?schema=public"

# Admin Authentication Credentials (Required for /generateapi)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Ryeon1121

# WebSocket Signaling Server URL (Public endpoint used by mobile & operator)
# Example for local development: ws://localhost:8080
# Example for production: wss://signaling.yourcompany.com
NEXT_PUBLIC_WS_URL=wss://signaling.example.com

# Dedicated Signaling Server Configuration (when running standalone server)
SIGNALING_PORT=8080

# WebRTC STUN / TURN Server Configuration (coturn / Twilio / Xirsys)
# Optional: defaults to Google public STUN servers if TURN is not provided
TURN_SERVER_URL=
TURN_USERNAME=
TURN_PASSWORD=
